NEXT_PUBLIC_PROJECT_ID=
NEXT_PUBLIC_RELAY_URL=wss://relay.walletconnect.com

# Session Fees POC
# Solana mainnet RPC used to broadcast swaps and read the fee recipient balance.
# Defaults to rpc.walletconnect.com (via NEXT_PUBLIC_PROJECT_ID) if unset; a dedicated
# RPC (Helius, Triton, etc.) is more reliable for sending transactions.
NEXT_PUBLIC_SOLANA_RPC_URL=
# Optional Jupiter API key from https://portal.jup.ag — raises rate limits and
# switches the base URL from lite-api.jup.ag to api.jup.ag.
NEXT_PUBLIC_JUPITER_API_KEY=
# Optional override for the Jupiter API base URL.
NEXT_PUBLIC_JUPITER_API_BASE=
