# All optional. The Relay must speak Sign v3; production doesn't yet.
NEXT_PUBLIC_RELAY_URL=https://pool-1.dev-relay.walletconnect.com
NEXT_PUBLIC_PROJECT_ID=sign-v3-demo
# Where "Open Ember Wallet" points.
NEXT_PUBLIC_WALLET_URL=http://localhost:3001
# Verify v4 App Signatures: sign every request with pages/api/wc-attestation.ts.
# `node scripts/app-signature-keys.mjs <host>` prints these and the Relay's registry entry.
# NEXT_PUBLIC_APP_SIGNATURE=on
# The hosts whose documents publish this key (`*.example.com` for any name under it).
# NEXT_PUBLIC_APP_SIGNATURE_DOMAINS=localhost
# APP_SIGNATURE_PRIVATE_JWK='{"kty":"EC","crv":"P-256",…}'
# Nimbus's own contracts: the backend signs value sent to these or to the account itself, only.
# NEXT_PUBLIC_NIMBUS_CONTRACTS=0x4e1b050000000000000000000000000000000001
# Signs the demo sign-in cookie. Default: derived from APP_SIGNATURE_PRIVATE_JWK.
# NIMBUS_SESSION_SECRET=
# NEVER in a deployment: serves pages/api/wc-attestation-insecure.ts, a backend that signs anything
# for anyone, for the Verify v4 POC's exploit demo (v3/e2e/tests/exploits-succeed.spec.ts).
# APP_SIGNATURE_INSECURE_DEMO=on
