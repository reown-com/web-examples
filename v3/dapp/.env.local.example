# All optional. The Relay must speak Sign v3; production doesn't yet.
NEXT_PUBLIC_RELAY_URL=https://pool-1.dev-relay.walletconnect.com
NEXT_PUBLIC_PROJECT_ID=sign-v3-demo
# Where "Open Ember Wallet" points.
NEXT_PUBLIC_WALLET_URL=http://localhost:3001
# Verify v4 App Signatures: sign every request with pages/api/wc-attestation.ts.
# `node scripts/app-signature-keys.mjs <host>` prints these and the Relay's registry entry.
# NEXT_PUBLIC_APP_SIGNATURE=on
# APP_SIGNATURE_DOMAIN=localhost
# APP_SIGNATURE_PRIVATE_JWK='{"kty":"EC","crv":"P-256",…}'
# APP_SIGNATURE_DENYLIST=0x000000000000000000000000000000000000dEaD
